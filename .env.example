# PostgreSQL connection settings.
# Copy this file to .env and fill in real values. Never commit .env.
# Phase 1 uses an admin/import user; Phase 5 adds a dedicated read-only app user.
PGHOST=localhost
PGPORT=5432
PGDATABASE=olist_copilot
PGUSER=postgres
PGPASSWORD=your_password_here

# LLM settings (Phase 3). Provider-independent: the app reads <PROVIDER>_* vars.
# OpenRouter is OpenAI-compatible; any provider can be added via app/llm/.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1