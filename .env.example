# PostgreSQL connection settings.
# Copy this file to .env and fill in real values. Never commit .env.
# Phase 1 uses an admin/import user; Phase 5 adds a dedicated read-only app user.
PGHOST=localhost
PGPORT=5432
PGDATABASE=olist_copilot
PGUSER=postgres
PGPASSWORD=your_password_here

# LLM settings (Phase 3). Provider-independent: the app reads <PROVIDER>_* vars.
# OpenRouter is OpenAI-compatible; any provider can be added via app/llm/.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding settings (Phase 4 RAG). Provider-independent, like the LLM settings.
# The OpenRouter embedding provider reuses OPENROUTER_API_KEY above.
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Optional overrides:
# OPENROUTER_EMBEDDING_API_KEY=      # defaults to OPENROUTER_API_KEY
# OPENROUTER_EMBEDDING_BASE_URL=     # defaults to OPENROUTER_BASE_URL
#
# Optional local baseline for retrieval comparison (not used in production):
#   pip install -r requirements-baseline.txt
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2