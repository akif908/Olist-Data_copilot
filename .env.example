# PostgreSQL connection settings.
# Copy this file to .env and fill in real values. Never commit .env.
# Phase 1 uses an admin/import user; Phase 5 adds a dedicated read-only app user.
PGHOST=localhost
PGPORT=5432
PGDATABASE=olist_copilot
PGUSER=postgres
PGPASSWORD=your_password_here

# LLM settings (needed from Phase 3 onward — leave commented for now)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=